@* CenterHub/Components/Pages/Tickets/TicketList.razor *@
@page "/tickets"
@rendermode InteractiveServer
@using CenterHub.Features.Tickets
@using CenterHub.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject TicketService TicketService
@inject AuthenticationStateProvider AuthProvider
@inject Microsoft.AspNetCore.Identity.UserManager<CenterHub.Models.ApplicationUser> UserManager
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">服務工單</h3>
    <a class="btn btn-primary" href="/tickets/new">+ 新增工單</a>
</div>

<div class="row row-cols-1 row-cols-md-auto g-3 align-items-end mb-3">
    <div class="col">
        <label class="form-label">日期</label>
        <input type="date" class="form-control" @bind="_filterDate" />
    </div>
    <div class="col">
        <label class="form-label">單位</label>
        <input type="text" class="form-control" @bind="_filterUnit" />
    </div>
    <div class="col">
        <label class="form-label">類別</label>
        <select class="form-select" @bind="_filterCategoryId">
            <option value="">全部</option>
            @foreach (var category in _categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div class="col">
        <label class="form-label">處理結果</label>
        <select class="form-select" @bind="_filterStatus">
            <option value="">全部</option>
            <option value="Completed">已完成</option>
            <option value="Incomplete">未完成</option>
        </select>
    </div>
    <div class="col">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="includeVoided" @bind="_includeVoided" />
            <label class="form-check-label" for="includeVoided">顯示已作廢</label>
        </div>
    </div>
    <div class="col">
        <button class="btn btn-outline-secondary" @onclick="LoadTickets">篩選</button>
    </div>
</div>

@if (_tickets is null)
{
    <p>載入中...</p>
}
else if (_tickets.Count == 0)
{
    <p class="text-muted">沒有符合條件的工單。</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr class="text-nowrap">
                    <th>編號</th><th>日期</th><th>班別</th><th>單位</th><th>申請人</th>
                    <th>類別</th><th>處理結果</th><th>時間(分)</th><th>承辦人</th><th>狀態</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in _tickets)
                {
                    <tr>
                        <td>@ticket.DailySeq</td>
                        <td>@ticket.ShiftDate</td>
                        <td>@ticket.ShiftPeriod</td>
                        <td>@ticket.RequestingUnit</td>
                        <td>@ticket.RequesterName</td>
                        <td>@GetCategoryNames(ticket)</td>
                        <td>@(ticket.ResolutionStatus == ResolutionStatus.Completed ? "已完成" : "未完成")</td>
                        <td>@ticket.ServiceDurationMinutes</td>
                        <td>@GetDisplayName(ticket.CreatedByUserId)</td>
                        <td>
                            @if (ticket.IsVoided)
                            {
                                <span class="badge text-bg-secondary">已作廢</span>
                            }
                        </td>
                        <td>
                            @if (!ticket.IsVoided && CanManage(ticket))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/tickets/@ticket.Id/edit">編輯</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => VoidTicket(ticket.Id)">作廢</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Ticket>? _tickets;
    private List<ServiceCategory> _categories = new();
    private Dictionary<string, string> _userDisplayNames = new();
    private string? _currentUserId;
    private bool _isAdmin;
    private DateTime? _filterDate;
    private string _filterUnit = "";
    private string _filterCategoryId = "";
    private string _filterStatus = "";
    private bool _includeVoided;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _isAdmin = authState.User.IsInRole(Roles.Admin);

        _categories = await TicketService.GetActiveCategoriesAsync();
        // Batch-loaded once rather than per-row; fine at this ~10-user scale.
        _userDisplayNames = await UserManager.Users.ToDictionaryAsync(u => u.Id, u => u.DisplayName);
        await LoadTickets();
    }

    private string GetDisplayName(string userId) => _userDisplayNames.GetValueOrDefault(userId, userId);

    private bool CanManage(Ticket ticket) => _isAdmin || ticket.CreatedByUserId == _currentUserId;

    private string GetCategoryNames(Ticket ticket)
    {
        var names = ticket.Categories
            .Select(c => _categories.FirstOrDefault(cat => cat.Id == c.ServiceCategoryId)?.Name ?? "未知類別");
        return string.Join(", ", names);
    }

    private async Task LoadTickets()
    {
        var filter = new TicketFilter
        {
            ShiftDate = _filterDate is { } d ? DateOnly.FromDateTime(d) : null,
            RequestingUnit = string.IsNullOrWhiteSpace(_filterUnit) ? null : _filterUnit,
            ServiceCategoryId = int.TryParse(_filterCategoryId, out var categoryId) ? categoryId : null,
            ResolutionStatus = _filterStatus switch
            {
                "Completed" => ResolutionStatus.Completed,
                "Incomplete" => ResolutionStatus.Incomplete,
                _ => null
            },
            IncludeVoided = _includeVoided
        };
        _tickets = await TicketService.GetTicketsAsync(filter);
    }

    private async Task VoidTicket(int ticketId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "確定要把這筆工單標記為作廢嗎？");
        if (!confirmed || _currentUserId is null)
            return;

        await TicketService.VoidTicketAsync(ticketId, _currentUserId, _isAdmin);
        await LoadTickets();
    }
}
