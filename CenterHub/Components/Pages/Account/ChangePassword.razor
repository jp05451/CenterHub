@* CenterHub/Components/Pages/Account/ChangePassword.razor *@
@page "/account/change-password"
@* Intentionally NOT @rendermode InteractiveServer: after the password changes the security stamp
   rotates, so the login cookie must be re-issued with SignInManager.RefreshSignInAsync. That writes
   to the original HTTP response, which only works during static server-side rendering — see
   Login.razor for the same constraint. *@
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CenterHub.Features.Accounts
@using CenterHub.Models
@using Microsoft.AspNetCore.Identity
@inject AccountService AccountService
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-4">
        <h3 class="mb-3">修改密碼</h3>

        <EditForm Model="_model" FormName="change-password" OnValidSubmit="DoChange">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="mb-3"><label class="form-label">目前密碼</label><InputText type="password" class="form-control" @bind-Value="_model.CurrentPassword" /></div>
            <div class="mb-3"><label class="form-label">新密碼</label><InputText type="password" class="form-control" @bind-Value="_model.NewPassword" /></div>
            <div class="mb-3"><label class="form-label">再輸入一次新密碼</label><InputText type="password" class="form-control" @bind-Value="_model.ConfirmPassword" /></div>
            <button type="submit" class="btn btn-primary w-100">修改密碼</button>
        </EditForm>

        @if (_error is not null)
        {
            <div class="alert alert-danger mt-3">@_error</div>
        }
        @if (_done)
        {
            <div class="alert alert-success mt-3">密碼已更新。</div>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ChangePasswordModel _model { get; set; } = default!;
    private string? _error;
    private bool _done;

    protected override void OnInitialized()
    {
        _model ??= new();
    }

    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "請輸入目前密碼")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "請輸入新密碼")]
        public string NewPassword { get; set; } = string.Empty;

        [Compare(nameof(NewPassword), ErrorMessage = "兩次輸入的新密碼不一致")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private async Task DoChange()
    {
        var userId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null)
            return;

        var result = await AccountService.ChangeOwnPasswordAsync(userId, _model.CurrentPassword, _model.NewPassword);
        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        var user = await UserManager.FindByIdAsync(userId);
        if (user is not null)
            await SignInManager.RefreshSignInAsync(user);

        _done = true;
    }
}
