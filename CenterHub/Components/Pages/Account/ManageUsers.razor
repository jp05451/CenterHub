@* CenterHub/Components/Pages/Account/ManageUsers.razor *@
@page "/account/manage-users"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using CenterHub.Features.Accounts
@using CenterHub.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject AccountService AccountService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Roles.Admin)]

<h3 class="mb-3">帳號管理</h3>

@if (_message is not null)
{
    <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")">@_message</div>
}

@if (_accounts is null)
{
    <p>載入中...</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr class="text-nowrap">
                    <th>帳號</th><th>顯示名稱</th><th>Email</th><th>角色</th><th>狀態</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in _accounts)
                {
                    <tr>
                        <td>@account.UserName</td>
                        <td>@account.DisplayName</td>
                        <td>@account.Email</td>
                        <td>@RoleLabel(account.Role)</td>
                        <td>
                            @if (account.IsDisabled)
                            {
                                <span class="badge text-bg-secondary">已停用</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">使用中</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(account)">編輯</button>
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => StartReset(account)">重設密碼</button>
                            @if (account.Id != _currentUserId)
                            {
                                @if (account.IsDisabled)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => SetDisabled(account, false)">啟用</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => SetDisabled(account, true)">停用</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_editTarget is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">編輯帳號：@_editTarget.UserName</h5>
            <EditForm Model="_editModel" OnValidSubmit="SaveEdit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="row g-3">
                    <div class="col-12 col-md-4"><label class="form-label">顯示名稱</label><InputText class="form-control" @bind-Value="_editModel.DisplayName" /></div>
                    <div class="col-12 col-md-4"><label class="form-label">Email</label><InputText class="form-control" @bind-Value="_editModel.Email" /></div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">角色</label>
                        <InputSelect class="form-select" @bind-Value="_editModel.Role" disabled="@(_editTarget.Id == _currentUserId)">
                            <option value="@Roles.WorkStudy">工讀生</option>
                            <option value="@Roles.Admin">管理員</option>
                        </InputSelect>
                        @if (_editTarget.Id == _currentUserId)
                        {
                            <div class="form-text">不能變更自己的角色。</div>
                        }
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">儲存</button>
                    <button type="button" class="btn btn-link" @onclick="CancelEdit">取消</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_resetTarget is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">重設密碼：@_resetTarget.UserName（@_resetTarget.DisplayName）</h5>
            <EditForm Model="_resetModel" OnValidSubmit="SaveReset">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="row g-3">
                    <div class="col-12 col-md-4"><label class="form-label">新密碼</label><InputText type="password" class="form-control" @bind-Value="_resetModel.NewPassword" /></div>
                </div>
                <div class="form-text">對方已登入的連線會在約一分鐘內被登出。</div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-warning">重設密碼</button>
                    <button type="button" class="btn btn-link" @onclick="CancelReset">取消</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="row">
    <div class="col-12 col-lg-6">
        <h5>新增帳號</h5>
        <EditForm Model="_newUser" OnValidSubmit="CreateUser">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="mb-3"><label class="form-label">顯示名稱</label><InputText class="form-control" @bind-Value="_newUser.DisplayName" /></div>
            <div class="mb-3"><label class="form-label">帳號</label><InputText class="form-control" @bind-Value="_newUser.UserName" /></div>
            <div class="mb-3"><label class="form-label">Email</label><InputText class="form-control" @bind-Value="_newUser.Email" /></div>
            <div class="mb-3"><label class="form-label">初始密碼</label><InputText type="password" class="form-control" @bind-Value="_newUser.Password" /></div>
            <div class="mb-3">
                <label class="form-label">角色</label>
                <InputSelect class="form-select" @bind-Value="_newUser.Role">
                    <option value="@Roles.WorkStudy">工讀生</option>
                    <option value="@Roles.Admin">管理員</option>
                </InputSelect>
            </div>
            <button type="submit" class="btn btn-primary">建立帳號</button>
        </EditForm>
    </div>
</div>

@code {
    private List<AccountInfo>? _accounts;
    private string _currentUserId = string.Empty;
    private string? _message;
    private bool _messageIsError;

    private NewUserModel _newUser = new();
    private AccountInfo? _editTarget;
    private EditModel _editModel = new();
    private AccountInfo? _resetTarget;
    private ResetModel _resetModel = new();

    public class NewUserModel
    {
        [Required(ErrorMessage = "請輸入顯示名稱")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "請輸入帳號")]
        public string UserName { get; set; } = string.Empty;

        // Every account needs a real email so any future notification feature has somewhere to send to.
        [Required(ErrorMessage = "請輸入 Email")]
        [EmailAddress(ErrorMessage = "請輸入有效的 Email 格式")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "請輸入初始密碼")]
        public string Password { get; set; } = string.Empty;

        public string Role { get; set; } = Roles.WorkStudy;
    }

    public class EditModel
    {
        [Required(ErrorMessage = "請輸入顯示名稱")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "請輸入 Email")]
        [EmailAddress(ErrorMessage = "請輸入有效的 Email 格式")]
        public string Email { get; set; } = string.Empty;

        public string Role { get; set; } = Roles.WorkStudy;
    }

    public class ResetModel
    {
        [Required(ErrorMessage = "請輸入新密碼")]
        public string NewPassword { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        await RunAsync(() => Task.FromResult(AccountResult.Ok), successMessage: null);
    }

    private static string RoleLabel(string role) => role == Roles.Admin ? "管理員" : "工讀生";

    private async Task RunAsync(Func<Task<AccountResult>> action, string? successMessage)
    {
        try
        {
            var result = await action();
            _messageIsError = !result.Succeeded;
            _message = result.Succeeded ? successMessage : result.Error;
            _accounts = await AccountService.GetAccountsAsync(_currentUserId);
        }
        catch (InvalidOperationException)
        {
            _messageIsError = true;
            _message = "你沒有權限執行這個操作，請重新登入。";
        }
    }

    private async Task CreateUser()
    {
        var model = _newUser;
        var account = new NewAccount(model.UserName, model.DisplayName, model.Email, model.Password, model.Role);
        await RunAsync(() => AccountService.CreateAccountAsync(_currentUserId, account), $"已建立帳號 {model.UserName}。");
        if (!_messageIsError)
            _newUser = new NewUserModel();
    }

    private void StartEdit(AccountInfo account)
    {
        CancelReset();
        _message = null;
        _editTarget = account;
        _editModel = new EditModel { DisplayName = account.DisplayName, Email = account.Email, Role = account.Role };
    }

    private void CancelEdit() => _editTarget = null;

    private async Task SaveEdit()
    {
        if (_editTarget is null)
            return;

        var target = _editTarget;
        var edit = new AccountEdit(_editModel.DisplayName, _editModel.Email, _editModel.Role);
        await RunAsync(() => AccountService.UpdateAccountAsync(_currentUserId, target.Id, edit), $"已更新帳號 {target.UserName}。");
        if (!_messageIsError)
            CancelEdit();
    }

    private void StartReset(AccountInfo account)
    {
        CancelEdit();
        _message = null;
        _resetTarget = account;
        _resetModel = new ResetModel();
    }

    private void CancelReset() => _resetTarget = null;

    private async Task SaveReset()
    {
        if (_resetTarget is null)
            return;

        var target = _resetTarget;
        var newPassword = _resetModel.NewPassword;
        await RunAsync(() => AccountService.ResetPasswordAsync(_currentUserId, target.Id, newPassword), $"已重設 {target.UserName} 的密碼。");
        if (!_messageIsError)
            CancelReset();
    }

    private async Task SetDisabled(AccountInfo account, bool disabled)
    {
        if (disabled)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", $"確定要停用 {account.UserName}（{account.DisplayName}）嗎？對方將無法登入，舊工單仍會保留。");
            if (!confirmed)
                return;
        }

        await RunAsync(
            () => AccountService.SetDisabledAsync(_currentUserId, account.Id, disabled),
            disabled ? $"已停用 {account.UserName}。" : $"已啟用 {account.UserName}。");
    }
}
